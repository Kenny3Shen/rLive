{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rLive",
  "version": "0.1.0",
  "identifier": "com.shenss.rlive",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "rLive",
        "decorations": false,
        "width": 1280,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/models/whisper-tiny/model-tiny-q40.gguf": "models/whisper-tiny/model-tiny-q40.gguf",
      "resources/models/whisper-tiny/config-tiny.json": "models/whisper-tiny/config-tiny.json",
      "resources/models/whisper-tiny/tokenizer-tiny.json": "models/whisper-tiny/tokenizer-tiny.json",
      "resources/models/whisper-tiny/melfilters.bytes": "models/whisper-tiny/melfilters.bytes",
      "resources/models/NOTICE.md": "models/NOTICE.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
