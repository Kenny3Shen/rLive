<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
  <external-path name="my_images" path="." />
  <cache-path name="my_cache_images" path="." />
  <!-- Tauri 的 app_data_dir 返回 Context.dataDir；下载根目录是其下的
       <dataDir>/rlive/downloads。Context.filesDir 通常是 <dataDir>/files，
       因此从 files/ 向上一级即可只暴露下载目录，而不是整个应用沙箱。 -->
  <files-path name="rlive_downloads" path="../rlive/downloads/" />
</paths>
