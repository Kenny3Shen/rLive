{
  "name": "rlive",
  "version": "2.10.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "oxlint --react-plugin src",
    "lint:fix": "oxlint --react-plugin --fix src",
    "format": "oxfmt --write src package.json vite.config.ts tsconfig.json tsconfig.node.json",
    "format:check": "oxfmt --check src package.json vite.config.ts tsconfig.json tsconfig.node.json",
    "check": "bun run lint && bunx tsc --noEmit",
    "test:danmaku": "bun test tests/danmu-js-adapter.test.ts tests/danmaku-actions.test.ts tests/playback-failover.test.ts",
    "test:unit": "bun test tests/",
    "preview": "vite preview",
    "tauri": "bun scripts/tauri.mjs",
    "bundle:linux": "bash scripts/build-linux-bundle.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "6.3.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@gsap/react": "2.1.2",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "danmu.js": "1.2.1",
    "google-translate-api-x": "10.7.3",
    "gsap": "3.15.0",
    "lucide-react": "^1.32.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xgplayer": "^3.0.26",
    "xgplayer-hls.js": "3.0.26",
    "xgplayer-mpegts.js": "^1.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "shadcn": "4.18.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "typescript-language-server": "^5.3.0",
    "vite": "^8.2.1"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "hono": "4.13.3",
    "js-yaml": "4.3.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "bun@1.3.14"
}
