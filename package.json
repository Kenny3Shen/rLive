{
  "name": "rlive",
  "version": "8.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "oxlint --react-plugin src",
    "format": "oxfmt --write src scripts package.json vite.config.ts tsconfig.json tsconfig.node.json",
    "check": "bun run lint && bunx tsc --noEmit && bunx tsc --noEmit -p tsconfig.node.json",
    "test:unit": "bun test tests/",
    "tauri": "bun scripts/tauri.ts",
    "icons": "bun scripts/generate-icons.ts",
    "icons:preview": "bun scripts/icon-preview.ts",
    "bundle:linux": "bash scripts/build-linux-bundle.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "6.3.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-virtual": "^3.14.19",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@videojs/core": "10.1.0",
    "@videojs/dash-video": "10.1.0",
    "@videojs/hlsjs-video": "10.1.0",
    "@videojs/react": "10.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "danmu": "^0.20.0",
    "google-translate-api-x": "10.7.3",
    "lucide-react": "^1.57.0",
    "mpegts.js": "1.8.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "shadcn": "4.21.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "typescript-language-server": "^6.0.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.8",
    "hono": "4.13.13",
    "js-yaml": "4.3.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "bun@1.4.3"
}
